{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/ws/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "fuellink-api"
      }
    }
  ],
  "services": {
    "fuellink-api": {
      "root": "backend",
      "entrypoint": "app.main:app",
      "buildCommand": "pip install -r requirements.txt"
    }
  }
}
