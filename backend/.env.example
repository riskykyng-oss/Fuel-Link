# Copy to .env and fill in. The app runs fully without any of these (mock payment mode).
FUELLINK_SECRET_KEY=change-me-to-a-long-random-string
FUELLINK_DATABASE_URL=sqlite:///./fuellink.db
FUELLINK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Paynow (Zimbabwe) - the aggregator that actually settles EcoCash / OneMoney / InnBucks.
# Register a merchant account at https://www.paynow.co.zw to obtain these.
# Leave blank to stay in MOCK mode (payments simulate success locally).
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RESULT_URL=http://localhost:8000/api/payments/paynow/callback
PAYNOW_RETURN_URL=http://localhost:5173/payment/return

# Delivery pricing
FUELLINK_DELIVERY_RATE_MULTIPLIER=3.0
FUELLINK_SEARCH_RADIUS_KM=20
